#!/usr/bin/env bash
set -euo pipefail

echo "🔍 Running pre-commit checks..."

# Detect changed files in the staging area
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

# ── Backend (Python) ──────────────────────────────────────────────
PY_FILES=$(echo "$STAGED_FILES" | grep '^backend/.*\.py$' || true)

if [ -n "$PY_FILES" ]; then
  echo "  → Backend: ruff format --check"
  cd backend
  # Strip backend/ prefix since we cd'd into the directory
  PY_REL=$(echo "$PY_FILES" | sed 's|^backend/||')
  uv run ruff format --check $PY_REL || {
    echo "❌ Backend formatting issues found. Run: uv run ruff format ."
    exit 1
  }
  echo "  → Backend: ruff check"
  uv run ruff check $PY_REL || {
    echo "❌ Backend lint issues found. Run: uv run ruff check ."
    exit 1
  }
  cd ..
fi

# ── Frontend (TypeScript/JS/JSX/TSX) ─────────────────────────────
JS_FILES=$(echo "$STAGED_FILES" | grep -E '^frontend/.*\.(ts|tsx|js|jsx)$' || true)

if [ -n "$JS_FILES" ]; then
  echo "  → Frontend: eslint"
  cd frontend
  JS_REL=$(echo "$JS_FILES" | sed 's|^frontend/||')
  JS_REL_ARGS=()
  while IFS= read -r file; do
    JS_REL_ARGS+=("$file")
  done <<< "$JS_REL"
  bun run lint --quiet --max-warnings=0 "${JS_REL_ARGS[@]}" || {
    echo "❌ Frontend lint issues found. Run: bun run lint"
    exit 1
  }
  cd ..
  echo "  ✓ Frontend checks passed"
fi

# ── No files to check ─────────────────────────────────────────────
if [ -z "$PY_FILES" ] && [ -z "$JS_FILES" ]; then
  echo "  (no staged Python or TypeScript files)"
fi

echo "✅ Pre-commit checks passed"
