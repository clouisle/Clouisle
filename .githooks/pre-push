#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(git rev-parse --show-toplevel)"

printf '🔍 Running pre-push checks...\n'

printf '\n→ Backend: Ruff format check\n'
(
  cd "$ROOT_DIR/backend"
  uv run ruff format --check .
)

printf '\n→ Frontend: ESLint check\n'
(
  cd "$ROOT_DIR/frontend"
  bun run lint
)

printf '\n→ Backend: full tests and global coverage\n'
(
  cd "$ROOT_DIR/backend"
  uv run pytest
  uv run python scripts/check_coverage.py
)

printf '\n→ Frontend: full tests and global coverage\n'
(
  cd "$ROOT_DIR/frontend"
  bun run test:coverage
  bun run coverage:check
)

printf '\n✅ Pre-push checks passed\n'
