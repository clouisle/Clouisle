# =============================================================================
# Clouisle Local Development Environment Configuration
# Copy this file to .env at the project root and modify as needed.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
SECRET_KEY=changethis-to-a-secure-random-secret-key
TIMEZONE=Asia/Shanghai

# URLs
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# Sandbox workers upload artifacts to this URL when set.
# For Docker Compose deployment, use http://api:8000 in deploy/.env.
SANDBOX_ARTIFACT_UPLOAD_BASE_URL=
SANDBOX_ARTIFACT_UPLOAD_API_KEY=

# -----------------------------------------------------------------------------
# PostgreSQL Database
# -----------------------------------------------------------------------------
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=clouisle
# DATABASE_URL=postgres://postgres:password@localhost:5432/clouisle

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# API instances: leave blank to use hostname; use a unique ID per container/Pod.
# All Gunicorn processes in one instance must share the same ID.
OBSERVABILITY_INSTANCE_ID=
OBSERVABILITY_INSTANCE_NAME=

# -----------------------------------------------------------------------------
# Qdrant Vector Database
# -----------------------------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=kb_dim
QDRANT_DISTANCE=Cosine

# -----------------------------------------------------------------------------
# Retrieval
# Lexical search uses pg_search in PostgreSQL; Qdrant remains the vector backend.
# -----------------------------------------------------------------------------
RETRIEVAL_HYBRID_KILL_SWITCH=false
RETRIEVAL_SHADOW_ENABLED=false

# -----------------------------------------------------------------------------
# Sandbox Runtime
# -----------------------------------------------------------------------------
# Advanced sandbox overrides: see docs/guide/deployment/environment-variables.md.
SANDBOX_WORKER_CONCURRENCY=1
SANDBOX_FILESYSTEM_ISOLATION_ENABLED=true
SANDBOX_FILESYSTEM_ISOLATION_BINARY=/usr/bin/bwrap

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
BACKEND_INTERNAL_URL=http://localhost:8000
