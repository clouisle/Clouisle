# =============================================================================
# Clouisle Docker Deployment Environment Variables
# Keep this file as .env next to docker-compose.yml.
# =============================================================================

# ---- General ----
PROJECT_NAME=Clouisle
SECRET_KEY=changethis-to-a-secure-random-secret-key
TIMEZONE=Asia/Shanghai

# ---- URLs ----
# Internal API address used by containers. Put public domains in FRONTEND_URL/CORS.
API_BASE_URL=http://api:8000
PUBLIC_API_URL=
API_INTERNAL_BASE_URL=http://api:8000
FRONTEND_URL=http://localhost:3000
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# Sandbox workers upload artifacts to this internal API address.
SANDBOX_ARTIFACT_UPLOAD_BASE_URL=http://api:8000
SANDBOX_ARTIFACT_UPLOAD_API_KEY=

# Worker -> api internal file gateway (worker has no uploads volume).
# INTERNAL_API_TOKEN must be shared by api and worker; keep it secret.
INTERNAL_API_TOKEN=

# ---- PostgreSQL ----
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=clouisle
# DATABASE_URL=postgres://postgres:password@db:5432/clouisle

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# API instances: hostname identifies each replica by default.
# If overriding, supply a distinct ID per container/Pod, not one ID for all replicas.
OBSERVABILITY_INSTANCE_ID=
OBSERVABILITY_INSTANCE_NAME=

# ---- Qdrant ----
VECTOR_BACKEND=qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=kb_dim
QDRANT_DISTANCE=Cosine

# ---- Retrieval ----
# Lexical search uses pg_search in PostgreSQL; Qdrant remains the vector backend.
RETRIEVAL_HYBRID_KILL_SWITCH=false
RETRIEVAL_SHADOW_ENABLED=false

# ---- Sandbox Runtime ----
SANDBOX_RUNTIME_ENABLED=true
SANDBOX_WORKER_CONCURRENCY=1
# Leave unset: the logical worker/storage identities are retained on each disk.
# Never assign one worker ID to independent disks or share one Compose volume.
SANDBOX_WORKER_ID=
SANDBOX_WORKSPACE_ROOT=/tmp/clouisle-sandbox/jobs
# Supplied deployments keep the same virtual roots in API/Agent/sandbox workers;
# only sandbox workers mount retained physical data. Compose overrides all roots.
SANDBOX_CHECKPOINT_ROOT=
SANDBOX_NODE_ID=
SANDBOX_WORKER_HEARTBEAT_SECONDS=5
SANDBOX_WORKER_HEARTBEAT_TTL_SECONDS=20
SANDBOX_WORKER_RECOVERY_SECONDS=30
SANDBOX_RECOVERY_POLL_SECONDS=0.5
SANDBOX_SESSION_MAX_RESETS=1
SANDBOX_SUPERVISOR_RESTART_SECONDS=1
SANDBOX_SUPERVISOR_MAX_RESTARTS=3
SANDBOX_FILESYSTEM_ISOLATION_ENABLED=true
SANDBOX_FILESYSTEM_ISOLATION_BINARY=/usr/bin/bwrap
SANDBOX_MAX_DISK_MB=8192
SANDBOX_SESSION_TTL_HOURS=24
SANDBOX_RESULT_TTL_SECONDS=86400
SANDBOX_ARTIFACT_MAX_FILE_SIZE_MB=10
SANDBOX_ARTIFACT_MAX_TOTAL_SIZE_MB=10

# ---- Frontend Build ----
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_APP_VERSION=0.0.0-dev
NEXT_PUBLIC_BUILD_DATE=unknown

# Internal API address used by the frontend server for SSR and API proxying.
BACKEND_INTERNAL_URL=http://api:8000

# ---- External APIs (optional) ----
TAVILY_API_KEY=
